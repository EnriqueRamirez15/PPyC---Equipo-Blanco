import pygame
import numpy as np
import time

# --- CONFIGURACIÓN DE LA SIMULACIÓN ---
ANCHO_PANTALLA = 800
ALTO_PANTALLA = 600
TAMANO_CELDA = 8  # Tamaño en píxeles de cada celda

# Calcular dimensiones de la matriz de celdas
COLS = ANCHO_PANTALLA // TAMANO_CELDA
FILAS = ALTO_PANTALLA // TAMANO_CELDA

# Colores (RGB)
COLOR_BG = (10, 10, 15) 
COLOR_REJILLA = (20, 20, 30)
COLOR_CELDA = (0, 255, 150)


def inicializar_tablero():
    """Crea un tablero aleatorio con ~20% de celdas vivas."""
    return np.random.choice([0, 1], size=(FILAS, COLS), p=[0.8, 0.2])


def actualizar_tablero(tablero):
    """
    Calcula la siguiente generación usando operaciones vectoriales de NumPy.
    Evita los bucles for anidados para optimizar el rendimiento secuencial.
    """
    # Matriz para almacenar el nuevo estado
    nuevo_tablero = np.zeros_like(tablero)
    
    # Conteo vectorial de vecinos usando "slicing" (rebanado de matrices)
    # Se suman los 8 vecinos desplazando la matriz en todas las direcciones
    vecinos = (
        tablero[:-2, :-2]  + tablero[:-2, 1:-1] + tablero[:-2, 2:] +
        tablero[1:-1, :-2]                      + tablero[1:-1, 2:] +
        tablero[2:, :-2]   + tablero[2:, 1:-1]  + tablero[2:, 2:]
    )
    
    # Aplicamos las reglas de Conway vectorialmente:
    sub_tablero = tablero[1:-1, 1:-1]
    
    # Regla 1 y 2: Supervivencia (celda viva y 2 o 3 vecinos)
    supervive = (sub_tablero == 1) & ((vecinos == 2) | (vecinos == 3))
    
    # Regla 3: Nacimiento (celda muerta y exactamente 3 vecinos)
    nace = (sub_tablero == 0) & (vecinos == 3)
    
    # Asignamos los nuevos estados a la zona interna del nuevo tablero
    nuevo_tablero[1:-1, 1:-1] = np.where(supervive | nace, 1, 0)
    
    return nuevo_tablero

def dibujar(pantalla, tablero):
    """Renderiza el estado actual del tablero en la pantalla."""
    pantalla.fill(COLOR_BG)
    
    # Encontrar los índices donde las celdas están vivas (valor == 1)
    filas_vivas, cols_vivas = np.where(tablero == 1)
    
    # Dibujar cada celda viva como un cuadrado
    for f, c in zip(filas_vivas, cols_vivas):
        rectangulo = (c * TAMANO_CELDA, f * TAMANO_CELDA, TAMANO_CELDA - 1, TAMANO_CELDA - 1)
        pygame.draw.rect(pantalla, COLOR_CELDA, rectangulo)


def main():
    pygame.init()
    pantalla = pygame.display.set_mode((ANCHO_PANTALLA, ALTO_PANTALLA))
    pygame.display.set_caption("Juego de la Vida de Conway - Secuencial")
    
    tablero = inicializar_tablero()
    reloj = pygame.time.Clock()
    ejecutando = True
    pausado = False
    
    print("Controles:")
    print("  [Espacio] - Pausar / Reanudar")
    print("  [R]       - Reiniciar tablero")
    print("  [Esc]     - Salir")
    
    while ejecutando:
        # 1. Gestión de Eventos
        for evento in pygame.event.get():
            if evento.type == pygame.QUIT:
                ejecutando = False
            elif evento.type == pygame.KEYDOWN:
                if evento.key == pygame.K_ESCAPE:
                    ejecutando = False
                elif evento.key == pygame.K_SPACE:
                    pausado = not pausado
                    estado = "PAUSADO" if pausado else "EJECUTANDO"
                    print(f"Estado: {estado}")
                elif evento.key == pygame.K_r:
                    tablero = inicializar_tablero()
                    print("Tablero reiniciado.")
        
        # 2. Actualización de la Lógica (Midiendo tiempo)
        if not pausado:
            inicio_tiempo = time.perf_counter()
            tablero = actualizar_tablero(tablero)
            fin_tiempo = time.perf_counter()
            
            # Imprime el tiempo que toma calcular esta generación
            ms = (fin_tiempo - inicio_tiempo) * 1000
            pygame.display.set_caption(f"Conway Secuencial | Cómputo Gen: {ms:.2f} ms")
        
        # 3. Renderizado
        dibujar(pantalla, tablero)
        pygame.display.flip()
        
        # Controlar los FPS de la visualización (puedes aumentarlo o quitarlo para pruebas de estrés)
        reloj.tick(30)
        
    pygame.quit()

if _name_ == "_main_":
    main()
